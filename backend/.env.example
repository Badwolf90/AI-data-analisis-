# Server Configuration
PROJECT_NAME="AI Data Analysis Platform API"
API_V1_STR="/api/v1"
SECRET_KEY="supersecretjwtkeyforaidataanalysisplatformchangeinproduction"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Settings (Async PostgreSQL or Fallback SQLite)
DATABASE_URL="sqlite+aiosqlite:///./ai_platform.db"
# For PostgreSQL: DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/ai_platform_db"

# Storage Settings
UPLOAD_DIR="./uploads"
MODEL_DIR="./models_registry"
REPORT_DIR="./generated_reports"

# Rate Limiting & Security
RATE_LIMIT_PER_MINUTE=100
ALLOWED_HOSTS=["*"]

# 9Router AI Proxy / Gateway Settings
NINEROUTER_BASE_URL="http://localhost:20128/v1"
NINEROUTER_MODEL="ag/gemini-3.5-flash-low"
NINEROUTER_ENABLED=true

